class_name CreditsPanel
extends MetaModal
## Credits and licence notices. Godot's MIT licence text is read from the
## engine itself, so it always matches the shipped binary. Asset vendors are
## listed as planned until their packs are actually imported.


func _init() -> void:
	super()
	max_size = Vector2(900, 940)
	accent = UiKit.AMBER


func open() -> void:
	title_text = Loc.t("Credits")
	super()


func _build() -> void:
	_section(Loc.t("Team"))
	_entry(Loc.t("Game direction"), "Sebastian List Feirup")
	_section(Loc.t("Engine"))
	_entry("Godot Engine %s" % Engine.get_version_info().get("string", ""), Loc.t("MIT license"))
	_section(Loc.t("Planned art and animation"))
	for vendor: String in ["Synty Studios", "PolyPerfect", "Mixamo"]:
		_entry(vendor, Loc.t("planned, pending import"), UiKit.TEXT_DIM)
	body.add_child(UiKit.label(Loc.t("These packs are not in the game yet. Everything you see now is drawn in code."), 15, UiKit.TEXT_DIM))
	_section(Loc.t("Audio"))
	body.add_child(UiKit.label(Loc.t("All current sounds and music are procedural placeholders generated by tools/gen_placeholder_audio.py. Final sounds are listed in docs/AUDIO_LEDGER.csv."), 16, UiKit.TEXT_DIM))
	_section(Loc.t("Godot Engine license"))
	var lic := UiKit.label(Engine.get_license_text(), 13, UiKit.TEXT_DIM)
	lic.name = "LicenseText"
	body.add_child(lic)


func _section(text: String) -> void:
	var l := UiKit.heading(text, 22, accent)
	body.add_child(l)


func _entry(left: String, right: String, right_color: Color = UiKit.TEXT) -> void:
	var row := UiKit.flow(16, false)
	var a := UiKit.label(left, 18, UiKit.TEXT, true)
	a.autowrap_mode = TextServer.AUTOWRAP_OFF
	row.add_child(a)
	var b := UiKit.label(right, 18, right_color)
	b.autowrap_mode = TextServer.AUTOWRAP_OFF
	row.add_child(b)
	body.add_child(row)
